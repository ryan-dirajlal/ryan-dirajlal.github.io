{
  "name": "Weekly GitHub Dev Summary via Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Weekly Trigger (Fri 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $vars.GITHUB_REPO }}/commits",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $vars.GITHUB_TOKEN }}" },
            { "name": "Accept", "value": "application/vnd.github.v3+json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "since", "value": "={{ $now.minus({ days: 7 }).toISO() }}" },
            { "name": "per_page", "value": "50" }
          ]
        }
      },
      "id": "get-commits",
      "name": "Get Commits (last 7 days)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 180]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $vars.GITHUB_REPO }}/issues",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $vars.GITHUB_TOKEN }}" },
            { "name": "Accept", "value": "application/vnd.github.v3+json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "state", "value": "closed" },
            { "name": "since", "value": "={{ $now.minus({ days: 7 }).toISO() }}" },
            { "name": "per_page", "value": "50" }
          ]
        }
      },
      "id": "get-issues",
      "name": "Get Closed Issues (last 7 days)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $vars.GITHUB_REPO }}/pulls",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $vars.GITHUB_TOKEN }}" },
            { "name": "Accept", "value": "application/vnd.github.v3+json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "state", "value": "closed" },
            { "name": "per_page", "value": "50" },
            { "name": "sort", "value": "updated" },
            { "name": "direction", "value": "desc" }
          ]
        }
      },
      "id": "get-prs",
      "name": "Get Merged PRs (last 7 days)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 420]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "multiplex",
        "options": {}
      },
      "id": "merge-data",
      "name": "Merge GitHub Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const commits = $input.all()[0].json || [];\nconst issues = $input.all()[1].json || [];\nconst prs = ($input.all()[2].json || []).filter(pr => pr.merged_at);\n\nconst lang = $vars.SUMMARY_LANGUAGE || 'EN';\n\nconst commitLines = Array.isArray(commits)\n  ? commits.slice(0, 20).map(c => `- ${c.commit?.message?.split('\\n')[0]} (${c.sha?.slice(0,7)})`).join('\\n')\n  : 'No commit data available';\n\nconst issueLines = Array.isArray(issues)\n  ? issues.slice(0, 10).map(i => `- #${i.number} ${i.title}`).join('\\n')\n  : 'No issues closed';\n\nconst prLines = Array.isArray(prs)\n  ? prs.slice(0, 10).map(p => `- #${p.number} ${p.title} (by @${p.user?.login})`).join('\\n')\n  : 'No PRs merged';\n\nconst langInstruction = lang === 'FR'\n  ? 'Respond entirely in French.'\n  : 'Respond in English.';\n\nreturn [{\n  json: {\n    prompt: `You are a technical writer generating a weekly developer newsletter.\\n${langInstruction}\\n\\nHere is the GitHub activity for repository {{ $vars.GITHUB_REPO }} over the past 7 days:\\n\\n## Commits (latest 20)\\n${commitLines}\\n\\n## Closed Issues\\n${issueLines}\\n\\n## Merged Pull Requests\\n${prLines}\\n\\nWrite a concise, engaging weekly summary (200–350 words) suitable for a team newsletter. Structure it as:\\n1. A short headline sentence\\n2. Key highlights (3–5 bullet points)\\n3. A brief \"What's next\" closing sentence based on open work trends.`,\n    repo: '{{ $vars.GITHUB_REPO }}',\n    commitCount: Array.isArray(commits) ? commits.length : 0,\n    issueCount: Array.isArray(issues) ? issues.length : 0,\n    prCount: Array.isArray(prs) ? prs.length : 0\n  }\n}];"
      },
      "id": "build-prompt",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $vars.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "model": "claude-sonnet-4-6",
          "max_tokens": 1024,
          "messages": [
            {
              "role": "user",
              "content": "={{ $json.prompt }}"
            }
          ]
        }
      },
      "id": "call-claude",
      "name": "Call Claude Sonnet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "jsCode": "const claudeResponse = $input.first().json;\nconst summary = claudeResponse?.content?.[0]?.text || 'No summary generated.';\nconst today = new Date().toISOString().split('T')[0];\nreturn [{ json: { summary, subject: `Weekly Dev Summary — ${today}`, date: today } }];"
      },
      "id": "extract-summary",
      "name": "Extract Summary Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $vars.SLACK_CHANNEL_ID }}",
          "mode": "id"
        },
        "text": "=:newspaper: *{{ $json.subject }}*\n\n{{ $json.summary }}",
        "otherOptions": {}
      },
      "id": "send-slack",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1560, 180],
      "credentials": {
        "slackApi": {
          "id": "slack-credential",
          "name": "Slack account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $vars.EMAIL_FROM }}",
        "toEmail": "={{ $vars.EMAIL_TO }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.summary }}"
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1560, 420],
      "credentials": {
        "smtp": {
          "id": "smtp-credential",
          "name": "SMTP account"
        }
      }
    }
  ],
  "connections": {
    "Weekly Trigger (Fri 5pm)": {
      "main": [[
        { "node": "Get Commits (last 7 days)", "type": "main", "index": 0 },
        { "node": "Get Closed Issues (last 7 days)", "type": "main", "index": 0 },
        { "node": "Get Merged PRs (last 7 days)", "type": "main", "index": 0 }
      ]]
    },
    "Get Commits (last 7 days)": {
      "main": [[{ "node": "Merge GitHub Data", "type": "main", "index": 0 }]]
    },
    "Get Closed Issues (last 7 days)": {
      "main": [[{ "node": "Merge GitHub Data", "type": "main", "index": 1 }]]
    },
    "Get Merged PRs (last 7 days)": {
      "main": [[{ "node": "Merge GitHub Data", "type": "main", "index": 2 }]]
    },
    "Merge GitHub Data": {
      "main": [[{ "node": "Build Claude Prompt", "type": "main", "index": 0 }]]
    },
    "Build Claude Prompt": {
      "main": [[{ "node": "Call Claude Sonnet", "type": "main", "index": 0 }]]
    },
    "Call Claude Sonnet": {
      "main": [[{ "node": "Extract Summary Text", "type": "main", "index": 0 }]]
    },
    "Extract Summary Text": {
      "main": [[
        { "node": "Send to Slack", "type": "main", "index": 0 },
        { "node": "Send Email", "type": "main", "index": 0 }
      ]]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "updatedAt": "2026-05-11T00:00:00.000Z",
  "versionId": "1"
}
